# =============================================================================
# CONFORA LMS — learner SPA (Vite). Samo varijable s prefiksom VITE_ idu u bundle.
# Kopiraj:  copy .env.example .env.local
# =============================================================================

# Bazni URL FastAPI backenda (axios, activity tracker, refresh) — backward compatible alias.
VITE_API_URL=http://localhost:8000

# Canonical API cutover (P0-A/B) — see docs/implementation/P0_AB_UNIFIED_FRONTEND_API_CLIENT_REPORT.md
VITE_LEGACY_API_URL=http://localhost:8000
VITE_CONFORA_API_URL=http://localhost:4000
# legacy | nest | hybrid
VITE_API_PROVIDER=legacy
# Optional auth stack in hybrid mode (legacy default until P0-E cutover): legacy | nest
# VITE_AUTH_PROVIDER=legacy
# Nest auth pilot (P0-E-2a): staging learner cohort only; requires VITE_AUTH_PROVIDER=nest
VITE_NEST_AUTH_PILOT_ENABLED=false
# F4-8b: canonical public contact (default true). Set false to use legacy POST /v1/public/contact alias.
VITE_CONTACT_CANONICAL_ENABLED=true
# F4-8c: canonical B15 complaints (default true). Set false for legacy /v1/me|admin/complaints read aliases only.
VITE_COMPLAINTS_CANONICAL_ENABLED=true
# F4-8d: canonical B14 appeals (default true). Set false for legacy /v1/me|admin/appeals read aliases only.
VITE_APPEALS_CANONICAL_ENABLED=true
# F4-8e: canonical F4 staff reports (default true). Set false for legacy /v1/admin/reports/catalog read alias only.
VITE_REPORTS_CANONICAL_ENABLED=true
# F4-8e: controlled report export via POST /v1/staff/reports/export (default true).
VITE_REPORT_EXPORT_ENABLED=true
# F4-8e: hide legacy report builder entry points (default true).
VITE_BLOCK_LEGACY_REPORT_BUILDER=true

# Samo za vite dev: otvori /dashboard bez prijave ako nemaš Cognito (mock korisnik).
# VITE_SKIP_AUTH_GUARD=true

# Puni URL za Google / Cognito Hosted UI dugme na registraciji (opcionalno).
# VITE_GOOGLE_OAUTH_URL=https://your-domain.auth.eu-central-1.amazoncognito.com/oauth2/authorize?...

# Stripe publishable key ako koristite Elements na klijentu (opcionalno).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Javni URL ove aplikacije (opcionalno, za linkove u klijentu).
# VITE_PUBLIC_APP_URL=http://localhost:5173

# Next.js javni sajt (verifikacija certifikata, linkovi iz learner app-a). Default u kodu: http://localhost:3000
# VITE_PUBLIC_WEB_URL=http://localhost:3000

# Javni obrasci — hCaptcha (kontakt /verify). Potrebno uz HCAPTCHA_SECRET na API-ju.
# VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# ISO 17024 RBAC (DynamoDB role iz /auth/me). Zadane vrijednosti u kodu ako ne postaviš.
# Kurikulum, item bank, roleplay — uključuje sys_admin i tech_committee.
# VITE_ADMIN_ROLES=admin,instructor,author,content_admin,sys_admin,tech_committee
# Odluke certifikacije (NE tech_committee).
# VITE_CERTIFICATION_ROLES=admin,instructor,author,content_admin,cert_committee,sys_admin
# Governance / rizici (NE tech_committee).
# VITE_GOVERNANCE_ROLES=admin,instructor,author,content_admin,sys_admin
