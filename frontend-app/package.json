{
  "name": "confora-frontend-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "a11y:ui-css": "npx --yes tailwindcss@3.4.15 -c ../packages/ui/tailwind.config.ts -i ../packages/ui/src/styles.css -o ../packages/ui/dist/styles.css --minify",
    "typecheck:a11y": "tsc -p tsconfig.a11y.json --pretty false",
    "build:a11y": "npm run a11y:ui-css && vite build -c vite.a11y.config.ts",
    "ci:a11y": "npm run typecheck:a11y && npm run build:a11y",
    "preview:a11y": "vite preview -c vite.a11y.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "audit:f4-frontend-api": "node ../scripts/ops/audit-f4-frontend-api-usage.mjs",
    "test:f4-cutover": "vitest run contact-client complaints grievances appeals reports api-reports f4-cutover-flags-defaults",
    "test:e2e:f4-smoke": "playwright test f4-cutover-smoke",
    "validate:f4-cutover": "node ../scripts/ops/run-f4-8g-frontend-validation.mjs",
    "seed:certification-demo": "python ../scripts/seed_certification_demo.py",
    "seed:pilot-demo": "python ../scripts/seed_pilot_demo.py",
    "seed:demo-full": "python ../scripts/seed_demo_full.py",
    "demo:seed": "npm run seed:demo-full",
    "lint:all": "tsc -b --pretty false",
    "build:all": "npm run build",
    "test:all": "npm run test",
    "security:check": "npm audit --audit-level=high",
    "ci:local": "npm run lint:all && npm run test:all && npm run build:all",
    "release:check": "python ../scripts/release_check.py",
    "pilot:check": "python ../scripts/pilot_check.py",
    "ga:check": "python ../scripts/ga_check.py"
  },
  "dependencies": {
    "@confora/i18n": "file:../packages/i18n",
    "@confora/ui": "file:../packages/ui",
    "@dnd-kit/core": "^6.3.1",
    "i18next": "^24.2.3",
    "react-i18next": "^15.4.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.96.2",
    "@tiptap/extension-bubble-menu": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-table-cell": "^3.22.3",
    "@tiptap/extension-table-header": "^3.22.3",
    "@tiptap/extension-table-row": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "axios": "^1.7.7",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.38.0",
    "immer": "^11.1.4",
    "lucide-react": "^0.446.0",
    "non.geist": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.5.3",
    "video.js": "^8.23.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^6.4.1",
    "vitest": "^3.1.4"
  }
}
