# =============================================================================
# CONFORA — Turborepo + Docker local development
# Copy to `.env` at the repository root. Never commit real secrets.
# =============================================================================

# Next.js: set to 1 in container builds (standalone tracing uses symlinks; may fail on Windows without dev mode).
# NEXT_STANDALONE=1

TURBO_TELEMETRY_DISABLED=1

# --- Apps ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
EXAMINER_START_URL=http://localhost:3000

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER=confora
POSTGRES_PASSWORD=confora_dev_change_me
POSTGRES_DB=confora
POSTGRES_PORT=15432
# Used by Nest Prisma/TypeORM later (localhost for host-run apps; service name in compose for containers)
# Staging pilot: 15432 avoids conflict with Windows postgres.exe on :5432 (container still listens on 5432 internally)
DATABASE_URL=postgresql://confora:confora_dev_change_me@localhost:15432/confora

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=confora
RABBITMQ_DEFAULT_PASS=confora_dev_change_me
RABBITMQ_URL=amqp://confora:confora_dev_change_me@localhost:5672/

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev_change_me
S3_BUCKET_CONFORA=confora-local

# --- Keycloak (OIDC) ---
# Staging pilot: 18080 avoids conflict with EnterpriseDB/other services on :8080 (container still :8080)
KEYCLOAK_PORT=18080
KEYCLOAK_BASE_URL=http://localhost:18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me
KEYCLOAK_REALM=confora
KEYCLOAK_CLIENT_ID=confora-web
OIDC_ISSUER_URL=http://localhost:18080/realms/confora
OIDC_CLIENT_ID=confora-web
OIDC_CLIENT_SECRET=set-in-keycloak-admin

# --- Mailhog (SMTP capture) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# --- AI (never bypass gateway in production) ---
AI_GATEWAY_BASE_URL=http://localhost:4000
# Optional vendor keys belong ONLY in secret stores / deployment env — not committed.

# --- Audit ---
AUDIT_INGEST_URL=http://localhost:4000

# --- Legacy Python/Vite stack (optional; see docs in repository) ---
# AWS_DEFAULT_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# VITE_API_URL=http://localhost:8000
