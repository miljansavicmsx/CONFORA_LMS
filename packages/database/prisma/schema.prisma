/// Placeholder signal only. No image, no biometric template, no automatic disqualification.
model ExamProctorFlag {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  sessionId  String              @db.Uuid
  source     ProctorSignalSource
  signalCode String              @db.VarChar(64)
  recordedAt DateTime            @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session CertificationExamSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  reviews ExamProctorFlagReview[]

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, recordedAt])
}

model ExamProctorFlagReview {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  flagId         String                 @db.Uuid
  reviewerUserId String                 @db.Uuid
  disposition    ExamProctorDisposition
  note           String?                @db.Text
  reviewedAt     DateTime               @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  flag     ExamProctorFlag @relation(fields: [tenantId, flagId], references: [tenantId, id], onDelete: Restrict)
  reviewer User            @relation(fields: [tenantId, reviewerUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, flagId])
}

model ExamItemStatistic {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  formId         String   @db.Uuid
  itemId         String   @db.Uuid
  attemptCount   Int
  pValue         Decimal  @db.Decimal(8, 5)
  pointBiserial  Decimal? @db.Decimal(8, 5)
  flagReason     String?  @db.VarChar(64)
  computedAt     DateTime @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  form   AssembledExamForm @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Restrict)
  item   SchemeExamItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, formId, itemId])
  @@index([tenantId, flagReason])
}

model ExamFormReliability {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  formId       String   @db.Uuid
  attemptCount Int
  kr20         Decimal? @db.Decimal(8, 5)
  flagReason   String?  @db.VarChar(64)
  computedAt   DateTime @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  form   AssembledExamForm @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, formId])
}

/// Three documents stay distinct (OD-PP-19, ISO/IEC 17024:2026 3.6).
enum ProfessionalCasePhase {
  ELIGIBILITY
  DOSSIER
  COMMITTEE
  APPROVED_FOR_ISSUANCE
  ISSUED
  DENIED
}

enum CertificationJourneyPath {
  CONFORA_EDUCATION
  DIRECT
}

enum ExperienceCheckMode {
  INDEPENDENT_REFERENCES
  OTHER_VERIFIABLE_EVIDENCE
}

enum AttestationState {
  PENDING_REVIEW
  ISSUED
}

enum CaseEvidenceKind {
  EDUCATION
  QUALIFICATION
  EXPERIENCE
  WORK
  OTHER
}

enum RefereeLinkState {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum OutboxStatus {
  QUEUED
  LOGGED
}

enum CommitteeSlotState {
  PROPOSED
  CONFIRMED
  EXCLUDED
}

enum CommitteeBallot {
  GRANT
  DENY
}

model SchemeLevelCriterion {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @db.Uuid
  schemeVersionId      String  @db.Uuid
  code                 String  @db.VarChar(32)
  title                String  @db.VarChar(128)
  rank                 Int
  minExperienceMonths  Int
  requiresExamPass     Boolean @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, schemeVersionId, code])
}

model SchemeDecisionMaker {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  schemeVersionId   String   @db.Uuid
  userId            String   @db.Uuid
  competenceNote    String   @db.Text
  authorisedFrom    DateTime @db.Timestamptz(3)
  authorisedUntil   DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)
  user          User                       @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, schemeVersionId, userId])
}

model SchemeCaseRule {
  id                      String              @id @default(uuid()) @db.Uuid
  tenantId                String              @db.Uuid
  schemeVersionId         String              @db.Uuid
  votingQuorum            Int                 @default(2)
  experienceMayFollowExam Boolean             @default(true)
  experienceMode          ExperienceCheckMode @default(INDEPENDENT_REFERENCES)
  referenceCount          Int                 @default(2)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, schemeVersionId])
}

/// Basic application through issuance. certificationApplicationId is a plain UUID (frozen table).
model ProfessionalCase {
  id                         String                   @id @default(uuid()) @db.Uuid
  tenantId                   String                   @db.Uuid
  applicantUserId            String                   @db.Uuid
  schemeVersionId            String                   @db.Uuid
  certificationApplicationId String                   @db.Uuid
  path                       CertificationJourneyPath
  phase                      ProfessionalCasePhase    @default(ELIGIBILITY)
  prerequisitesAcknowledgedAt DateTime?               @db.Timestamptz(3)
  experienceMonths           Int                      @default(0)
  computedLevelCode          String?                  @db.VarChar(32)
  examResultId               String?                  @db.Uuid
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicant     User                       @relation("ProfessionalCaseApplicant", fields: [tenantId, applicantUserId], references: [tenantId, id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)
  evidence      CaseEvidenceItem[]
  referees      RefereeConfirmation[]
  proposals     CommitteeProposal[]
  assessments   CommitteeAssessment[]
  authorization IssuanceAuthorization?
  suggestions   AiCaseSuggestion[]
  conflictDeclarations CommitteeConflictDeclaration[]

  @@unique([tenantId, id])
  @@index([tenantId, applicantUserId, phase])
}

model EducationCompletionDocument {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  enrolmentId            String   @db.Uuid
  holderUserId           String   @db.Uuid
  publicUid              String   @unique @db.VarChar(32)
  courseTitle            String   @db.VarChar(256)
  participationSeconds   Int
  statement              String   @db.Text
  issuedAt               DateTime @db.Timestamptz(3)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  enrolment Enrolment @relation(fields: [tenantId, enrolmentId], references: [tenantId, id], onDelete: Restrict)
  holder    User      @relation(fields: [tenantId, holderUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, enrolmentId])
}

model ExamPassAttestation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  resultId        String           @db.Uuid
  holderUserId    String           @db.Uuid
  publicUid       String           @unique @db.VarChar(32)
  state           AttestationState
  examTitle       String           @db.VarChar(256)
  passed          Boolean
  autoIssued      Boolean
  statement       String           @db.Text
  issuedAt        DateTime?        @db.Timestamptz(3)
  reviewedByUserId String?         @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  result CertificationExamResult @relation(fields: [tenantId, resultId], references: [tenantId, id], onDelete: Restrict)
  holder User                    @relation(fields: [tenantId, holderUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, resultId])
}

model CaseEvidenceItem {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  caseId    String           @db.Uuid
  kind      CaseEvidenceKind
  title     String           @db.VarChar(256)
  objectKey String?          @db.VarChar(512)
  summary   String?          @db.Text
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, caseId])
}

model RefereeConfirmation {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  caseId           String           @db.Uuid
  refereeName      String           @db.VarChar(256)
  organization     String           @db.VarChar(256)
  email            String           @db.VarChar(256)
  tokenHash        String           @unique @db.Char(64)
  expiresAt        DateTime         @db.Timestamptz(3)
  state            RefereeLinkState @default(PENDING)
  requestedFacts   String           @db.Text
  confirmedFacts   String?          @db.Text
  discrepancies    String?          @db.Text
  confirmedAt      DateTime?        @db.Timestamptz(3)
  relevanceNote    String?          @db.Text
  credible         Boolean?
  assessedByUserId String?          @db.Uuid
  assessedAt       DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, caseId])
}

model MessageOutbox {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  toAddress String       @db.VarChar(256)
  subject   String       @db.VarChar(256)
  body      String       @db.Text
  status    OutboxStatus @default(LOGGED)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
}

model CommitteeProposal {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  caseId             String              @db.Uuid
  userId             String              @db.Uuid
  state              CommitteeSlotState
  exclusionReason    String?             @db.VarChar(64)
  confirmedByUserId  String?             @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)
  member User             @relation("CommitteeProposalMember", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, caseId, userId])
}

model CommitteeAssessment {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  caseId       String           @db.Uuid
  memberUserId String           @db.Uuid
  ballot       CommitteeBallot
  reasoning    String           @db.Text
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)
  member User             @relation(fields: [tenantId, memberUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, caseId, memberUserId])
}

model IssuanceAuthorization {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  caseId             String   @db.Uuid
  authorisedByUserId String   @db.Uuid
  note               String   @db.Text
  authorisedAt       DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)
  authoriser User             @relation(fields: [tenantId, authorisedByUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, caseId])
}

model AiCaseSuggestion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  caseId     String   @db.Uuid
  purpose    String   @db.VarChar(64)
  suggestion String   @db.Text
  model      String   @db.VarChar(64)
  promptHash String   @db.Char(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case   ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, caseId])
}

/// Append-only conflict history. The latest row for a member is the effective declaration.
model CommitteeConflictDeclaration {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  caseId           String   @db.Uuid
  userId           String   @db.Uuid
  recordedByUserId String   @db.Uuid
  hasConflict      Boolean
  statement        String   @db.Text
  signedAt         DateTime @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case       ProfessionalCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict)
  member     User             @relation("ConflictDeclarationSubject", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  recordedBy User             @relation("ConflictDeclarationRecorder", fields: [tenantId, recordedByUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, caseId, userId, signedAt])
}

model TenantAiBudget {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  periodKey      String   @db.VarChar(7)
  unitLimit      Int
  unitsUsed      Int      @default(0)
  costLimitMinor Int
  costUsedMinor  Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, periodKey])
}

enum NoticeChannel {
  EMAIL
  IN_APP
}

enum NoticeJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BOUNCED
  COMPLAINT
}

enum NoticeKind {
  CERTIFICATE_EXPIRY
  RECERTIFICATION
  EXAM
  FEE
  GENERAL
}

model NoticeJob {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  recipientUserId String          @db.Uuid
  channel         NoticeChannel
  kind            NoticeKind
  referenceId     String          @db.VarChar(64)
  toAddress       String          @db.VarChar(256)
  subject         String          @db.VarChar(256)
  body            String          @db.Text
  status          NoticeJobStatus @default(QUEUED)
  attempts        Int             @default(0)
  maxAttempts     Int             @default(3)
  nextAttemptAt   DateTime        @db.Timestamptz(3)
  lastError       String?         @db.VarChar(512)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient User         @relation(fields: [tenantId, recipientUserId], references: [tenantId, id], onDelete: Restrict)
  inApp     InAppNotice?

  @@unique([tenantId, id])
  @@unique([tenantId, kind, referenceId, channel])
  @@index([tenantId, status, nextAttemptAt])
}

model InAppNotice {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  jobId     String    @db.Uuid
  title     String    @db.VarChar(256)
  body      String    @db.Text
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  job    NoticeJob @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, jobId])
  @@index([tenantId, userId, createdAt])
}

model SchemeAnnualFee {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  schemeVersionId         String   @db.Uuid
  annualAmountMinor       Int
  currency                String   @db.VarChar(3)
  firstYearIncluded       Boolean  @default(true)
  recertificationSeparate Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, schemeVersionId])
}

enum AnnualFeeKind {
  FIRST_YEAR
  ANNUAL
  RECERTIFICATION
}

enum AnnualFeeStatus {
  INCLUDED
  DUE
  OPEN_CASE
  SETTLED
}

model AnnualFeeObligation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  schemeVersionId String          @db.Uuid
  credentialId    String          @db.Uuid
  holderUserId    String          @db.Uuid
  year            Int
  kind            AnnualFeeKind
  amountMinor     Int
  currency        String          @db.VarChar(3)
  status          AnnualFeeStatus
  reason          String?         @db.Text
  openedAt        DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)
  credential    Credential                 @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Restrict)
  holder        User                       @relation(fields: [tenantId, holderUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, credentialId, year, kind])
  @@index([tenantId, holderUserId, status])
}
