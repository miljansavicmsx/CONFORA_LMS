  domains          ExamBlueprintDomain[]
  standardSettings StandardSettingRecord[]
  forms            AssembledExamForm[]

  @@unique([tenantId, id])
  @@index([tenantId, schemeVersionId, status])
}

model ExamBlueprintDomain {
