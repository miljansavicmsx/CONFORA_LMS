model ExamCertificationDecision {
  id                     String                           @id @default(uuid()) @db.Uuid
  tenantId               String                           @db.Uuid
  resultId               String                           @db.Uuid
  decidedByUserId        String                           @db.Uuid
  outcome                ExamCertificationDecisionOutcome
  rationale              String                           @db.Text
  trainerOfCandidate     Boolean
  independentOfTraining  Boolean
  decidedAt              DateTime                         @db.Timestamptz(3)
  createdAt              DateTime                         @default(now()) @db.Timestamptz(3)

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  result  CertificationExamResult @relation(fields: [tenantId, resultId], references: [tenantId, id], onDelete: Restrict)
  decider User                    @relation(fields: [tenantId, decidedByUserId], references: [tenantId, id], onDelete: Restrict)
  personnelIssue ExamPersonnelCredentialLink?

