  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  sessionId       String   @db.Uuid
  identityCheckId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session       CertificationExamSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  identityCheck IdentityCheck            @relation(fields: [tenantId, identityCheckId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId])
  @@index([tenantId, identityCheckId])
}

model CertificationExamAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  sessionId    String   @db.Uuid
  itemId       String   @db.Uuid
