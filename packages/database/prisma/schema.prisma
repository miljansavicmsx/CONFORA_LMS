model AssembledExamFormItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  formId     String   @db.Uuid
  itemId     String   @db.Uuid
  domainCode String   @db.VarChar(64)
  sequence   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  form   AssembledExamForm @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Restrict)
  item   SchemeExamItem    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, formId, itemId])
  @@unique([tenantId, formId, sequence])
}

model CertificationExamSession {
  id                         String                         @id @default(uuid()) @db.Uuid
  tenantId                   String                         @db.Uuid
  formId                     String                         @db.Uuid
  candidateUserId            String                         @db.Uuid
  certificationApplicationId String                         @db.Uuid
  scheduledStartAt           DateTime                       @db.Timestamptz(3)
  invigilatorUserId          String                         @db.Uuid
  status                     CertificationExamSessionStatus @default(SCHEDULED)
  rulesAcceptedAt            DateTime?                      @db.Timestamptz(3)
  ndaAcceptedAt              DateTime?                      @db.Timestamptz(3)
  mfaReference               String?                        @db.VarChar(64)
  identityCaptureState       IdentityCaptureState           @default(NOT_COLLECTED_DPIA_PENDING)
  extraTimePercent           Int                            @default(0)
  startedAt                  DateTime?                      @db.Timestamptz(3)
  expiresAt                  DateTime?                      @db.Timestamptz(3)
  submittedAt                DateTime?                      @db.Timestamptz(3)
  createdAt                  DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                       @updatedAt @db.Timestamptz(3)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  form        AssembledExamForm         @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Restrict)
  candidate   User                      @relation("CertificationExamCandidate", fields: [tenantId, candidateUserId], references: [tenantId, id], onDelete: Restrict)
  invigilator User                      @relation("CertificationExamInvigilator", fields: [tenantId, invigilatorUserId], references: [tenantId, id], onDelete: Restrict)
  answers      CertificationExamAnswer[]
  result       CertificationExamResult?
  proctorFlags ExamProctorFlag[]
  identityLink CertificationExamIdentityLink?

  @@unique([tenantId, id])
  @@index([tenantId, candidateUserId, status])
  @@index([tenantId, certificationApplicationId])
}

/// Binds a certification exam session to a non-image IdentityCheck before the session is ready.
