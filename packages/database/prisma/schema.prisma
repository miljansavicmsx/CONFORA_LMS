  blueprint   ExamBlueprint            @relation(fields: [tenantId, blueprintId], references: [tenantId, id], onDelete: Restrict)
  assembler   User                     @relation(fields: [tenantId, assembledByUserId], references: [tenantId, id], onDelete: Restrict)
  items       AssembledExamFormItem[]
  sessions    CertificationExamSession[]
  statistics  ExamItemStatistic[]
  reliability ExamFormReliability?

  @@unique([tenantId, id])
  @@index([tenantId, blueprintId])
