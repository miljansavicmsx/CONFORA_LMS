generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                              String                           @id @default(uuid()) @db.Uuid
  isActive                        Boolean                          @default(false)
  users                           User[]
  auditEvents                     AuditEvent[]
  auditChainHead                  AuditChainHead?
  certificationApplications       CertificationApplication[]
  complaintCases                  ComplaintCase[]
  appealCases                     AppealCase[]
  userProfiles                    UserProfile[]
  accessibilityNeeds              UserAccessibilityNeed[]
  committeeMemberships            CommitteeMembership[]
  breakGlassEvents                BreakGlassAccess[]
  staffDeclarations               StaffDeclaration[]
  competences                     Competence[]
  proficiencyLevels               ProficiencyLevel[]
  courses                         Course[]
  courseChapters                  CourseChapter[]
  courseLessons                   CourseLesson[]
  contentBlocks                   ContentBlock[]
  courseApprovals                 CourseApproval[]
  enrolments                      Enrolment[]
  enrolmentTrainers               EnrolmentTrainer[]
  lessonProgresses                LessonProgress[]
  learningActivityRecords         LearningActivityRecord[]
  enrolmentPaymentIntents         EnrolmentPaymentIntent[]
  learnerAnalyticsConsents        LearnerAnalyticsConsent[]
  chapterQuizAttempts             ChapterQuizAttempt[]
  chapterQuizAttemptAnswers       ChapterQuizAttemptAnswer[]
  itemScenarioGroups              ItemScenarioGroup[]
  itemScenarioMemberships         ItemScenarioMembership[]
  assessmentItems                 AssessmentItem[]
  assessmentItemChoices           AssessmentItemChoice[]
  assessmentItemCompetences       AssessmentItemCompetence[]
  itemReviews                     ItemReview[]
  quizzes                         Quiz[]
  quizItems                       QuizItem[]
  examForms                       ExamForm[]
  examFormItems                   ExamFormItem[]
  examFormCourses                 ExamFormCourse[]
  examFormSchemes                 ExamFormScheme[]
  identityChecks                  IdentityCheck[]
  examSessions                    ExamSession[]
  examDutyAssignments             ExamDutyAssignment[]
  examAttempts                    ExamAttempt[]
  examAttemptAnswers              ExamAttemptAnswer[]
  proctorSignals                  ProctorSignal[]
  proctorSignalReviews            ProctorSignalReview[]
  certificationSchemes            CertificationScheme[]
  certificationSchemeVersions     CertificationSchemeVersion[]
  schemeCompetenceRequirements    SchemeCompetenceRequirement[]
  certificationApplicationDetails CertificationApplicationDetail[]
  applicationExperiences          ApplicationExperience[]
  applicationReferees             ApplicationReferee[]
  certificationDecisions          CertificationDecision[]
  decisionParticipants            DecisionParticipant[]
  credentials                     Credential[]
  attendanceCredentialLinks       AttendanceCredentialLink[]
  personnelCredentialLinks        PersonnelCredentialLink[]
  achievementRecords              AchievementRecord[]
  credentialLifecycleEvents       CredentialLifecycleEvent[]
  verificationLogs                VerificationLog[]
  recertificationCases            RecertificationCase[]
  recertificationOutcomes         RecertificationOutcome[]
  invoices                        Invoice[]
  payments                        Payment[]
  amfMemberships                  AmfMembership[]
  amfSuspensionProposals          AmfSuspensionProposal[]
  amfSuspensionConfirmations      AmfSuspensionConfirmation[]
  controlledDocuments             ControlledDocument[]
  documentVersions                DocumentVersion[]
  documentApprovals               DocumentApproval[]
  riskRecords                     RiskRecord[]
  internalAudits                  InternalAudit[]
  correctiveActions               CorrectiveAction[]
  managementReviews               ManagementReview[]
  impartialityReports             ImpartialityReport[]
  aiSystems                       AiSystem[]
  aiSuggestions                   AiSuggestion[]
  aiSuggestionReviews             AiSuggestionReview[]
  aiAuditRecords                  AiAuditRecord[]
  aiDisclosureAcknowledgements    AiDisclosureAcknowledgement[]
  schemeExamItems                 SchemeExamItem[]
  schemeExamItemChoices           SchemeExamItemChoice[]
  schemeExamItemCompetences       SchemeExamItemCompetence[]
  schemeExamItemTransitions       SchemeExamItemTransition[]
  examBlueprints                  ExamBlueprint[]
  examBlueprintDomains            ExamBlueprintDomain[]
  standardSettingRecords          StandardSettingRecord[]
  standardSettingRatings          StandardSettingRating[]
  assembledExamForms              AssembledExamForm[]
  assembledExamFormItems          AssembledExamFormItem[]
  certificationExamSessions       CertificationExamSession[]
  certificationExamAnswers        CertificationExamAnswer[]
  certificationExamResults        CertificationExamResult[]
  examCertificationDecisions      ExamCertificationDecision[]
  examProctorFlags                ExamProctorFlag[]
  examProctorFlagReviews          ExamProctorFlagReview[]
  examItemStatistics              ExamItemStatistic[]
  examFormReliabilities           ExamFormReliability[]
  certificationExamIdentityLinks  CertificationExamIdentityLink[]
  examPersonnelCredentialLinks    ExamPersonnelCredentialLink[]
  recertificationReminders        RecertificationReminder[]
  cpdRecords                      CpdRecord[]
  schemeLevelCriteria             SchemeLevelCriterion[]
  schemeDecisionMakers            SchemeDecisionMaker[]
  schemeCaseRules                 SchemeCaseRule[]
  professionalCases               ProfessionalCase[]
  educationCompletionDocuments    EducationCompletionDocument[]
  examPassAttestations            ExamPassAttestation[]
  caseEvidenceItems               CaseEvidenceItem[]
  refereeConfirmations            RefereeConfirmation[]
  messageOutbox                   MessageOutbox[]
  committeeProposals              CommitteeProposal[]
  committeeAssessments            CommitteeAssessment[]
  issuanceAuthorizations          IssuanceAuthorization[]
  aiCaseSuggestions               AiCaseSuggestion[]
  committeeConflictDeclarations   CommitteeConflictDeclaration[]
  tenantAiBudgets                 TenantAiBudget[]
  noticeJobs                      NoticeJob[]
  inAppNotices                    InAppNotice[]
  schemeAnnualFees                SchemeAnnualFee[]
  annualFeeObligations            AnnualFeeObligation[]
}

model User {
  id                                 String                           @id @default(uuid()) @db.Uuid
  tenantId                           String                           @db.Uuid
  email                              String
  isActive                           Boolean                          @default(false)
  tenant                             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  externalIdentities                 ExternalIdentityLink[]
  auditEvents                        AuditEvent[]
  certificationApplications          CertificationApplication[]
  complaintCases                     ComplaintCase[]
  appealCasesAsAppellant             AppealCase[]                     @relation("AppealCaseAppellant")
  appealCasesAsOriginalDecisionMaker AppealCase[]                     @relation("AppealCaseOriginalDecisionMaker")
  profile                            UserProfile?
  accessibilityNeeds                 UserAccessibilityNeed[]
  committeeMemberships               CommitteeMembership[]            @relation("CommitteeMember")
  committeeAppointments              CommitteeMembership[]            @relation("CommitteeAppointer")
  breakGlassEvents                   BreakGlassAccess[]
  staffDeclarations                  StaffDeclaration[]
  authoredCourses                    Course[]                         @relation("CourseAuthor")
  courseApprovals                    CourseApproval[]
  learnerEnrolments                  Enrolment[]
  enrolmentTrainerDuties             EnrolmentTrainer[]
  learningActivityRecords            LearningActivityRecord[]
  learnerAnalyticsConsent            LearnerAnalyticsConsent?
  itemReviews                        ItemReview[]
  identityChecksAsSubject            IdentityCheck[]                  @relation("IdentityCheckSubject")
  identityChecksReviewed             IdentityCheck[]                  @relation("IdentityCheckReviewer")
  candidateExamSessions              ExamSession[]                    @relation("ExamCandidate")
  invigilatedExamSessions            ExamSession[]                    @relation("ExamInvigilator")
  examDutyAssignments                ExamDutyAssignment[]
  applicationDetails                 CertificationApplicationDetail[]
  decisionsChaired                   CertificationDecision[]          @relation("DecisionChair")
  decisionParticipations             DecisionParticipant[]
  heldCredentials                    Credential[]
  credentialLifecycleEvents          CredentialLifecycleEvent[]
  recertificationCases               RecertificationCase[]
  invoices                           Invoice[]
  payments                           Payment[]
  amfMemberships                     AmfMembership[]
  amfSuspensionProposals             AmfSuspensionProposal[]
  amfSuspensionConfirmations         AmfSuspensionConfirmation[]
  documentApprovals                  DocumentApproval[]
  ownedRisks                         RiskRecord[]
  ledInternalAudits                  InternalAudit[]
  raisedCorrectiveActions            CorrectiveAction[]               @relation("CorrectiveActionRaiser")
  ownedCorrectiveActions             CorrectiveAction[]               @relation("CorrectiveActionOwner")
  chairedManagementReviews           ManagementReview[]
  aiSuggestionReviews                AiSuggestionReview[]
  aiAuditRecords                     AiAuditRecord[]
  aiDisclosureAcknowledgements       AiDisclosureAcknowledgement[]
  proctorSignalReviews               ProctorSignalReview[]
  authoredSchemeExamItems            SchemeExamItem[]                 @relation("SchemeExamItemAuthor")
  schemeExamItemTransitions          SchemeExamItemTransition[]
  standardSettingRatings             StandardSettingRating[]          @relation("StandardSettingPanelist")
  approvedStandardSettings           StandardSettingRecord[]          @relation("StandardSettingApprover")
  assembledExamForms                 AssembledExamForm[]
  candidateCertificationExams        CertificationExamSession[]       @relation("CertificationExamCandidate")
  invigilatedCertificationExams      CertificationExamSession[]       @relation("CertificationExamInvigilator")
  examCertificationDecisions         ExamCertificationDecision[]
  examProctorFlagReviews             ExamProctorFlagReview[]
  cpdRecords                         CpdRecord[]
  schemeDecisionMakers               SchemeDecisionMaker[]
  professionalCasesAsApplicant       ProfessionalCase[]                 @relation("ProfessionalCaseApplicant")
  educationCompletionDocuments       EducationCompletionDocument[]
  examPassAttestations               ExamPassAttestation[]
  committeeProposalsAsMember         CommitteeProposal[]                @relation("CommitteeProposalMember")
  committeeAssessments               CommitteeAssessment[]
  issuanceAuthorizations             IssuanceAuthorization[]
  conflictDeclarations               CommitteeConflictDeclaration[] @relation("ConflictDeclarationSubject")
  recordedConflictDeclarations       CommitteeConflictDeclaration[] @relation("ConflictDeclarationRecorder")
  noticeJobs                         NoticeJob[]
  inAppNotices                       InAppNotice[]
  annualFeeObligations               AnnualFeeObligation[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
}

model ExternalIdentityLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid
  issuer   String
  subject  String
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, issuer, subject])
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum CertificationApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CertificationApplication {
  id              String                         @id @default(uuid()) @db.Uuid
  tenantId        String                         @db.Uuid
  applicantUserId String                         @db.Uuid
  status          CertificationApplicationStatus
  schemeRef       String                         @db.VarChar(128)
  submittedAt     DateTime?                      @db.Timestamptz(3)
  createdAt       DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                       @updatedAt @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicant User   @relation(fields: [tenantId, applicantUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, applicantUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, applicantUserId, status])
}

model ComplaintCase {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @db.Uuid
  internalCaseId    String @db.VarChar(128)
  complainantUserId String @db.Uuid

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  complainant User   @relation(fields: [tenantId, complainantUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, internalCaseId])
}

model AppealCase {
  id                             String  @id @default(uuid()) @db.Uuid
  tenantId                       String  @db.Uuid
  internalCaseId                 String  @db.VarChar(128)
  appellantUserId                String  @db.Uuid
  certificationDecisionReference String  @db.VarChar(128)
  originalDecisionMakerUserId    String  @db.Uuid
  committeeIdentifier            String? @db.VarChar(128)

  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appellant             User   @relation("AppealCaseAppellant", fields: [tenantId, appellantUserId], references: [tenantId, id], onDelete: Restrict)
  originalDecisionMaker User   @relation("AppealCaseOriginalDecisionMaker", fields: [tenantId, originalDecisionMakerUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, internalCaseId])
}

model AuditEvent {
  id             String       @id @db.Uuid
  tenantId       String       @db.Uuid
  sequence       BigInt
  idempotencyKey String       @db.Uuid
  actorUserId    String       @db.Uuid
  eventType      String       @db.VarChar(128)
  outcome        AuditOutcome
  resourceType   String?      @db.VarChar(128)
  resourceId     String?      @db.VarChar(128)
  occurredAt     DateTime     @db.Timestamptz(3)
  recordedAt     DateTime     @db.Timestamptz(3)
  correlationId  String?      @db.VarChar(128)
  metadata       Json?
  prevHash       String       @db.Char(64)
  payloadHash    String       @db.Char(64)
  chainHash      String       @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, sequence])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, recordedAt])
}

model AuditChainHead {
  tenantId     String @id @db.Uuid
  lastSequence BigInt
  lastHash     String @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// Product-plan domain (OD-PP-14, 2026-10-19).
/// CertificationApplication is frozen: details store its id without a foreign key.
/// Personnel certificates require PersonnelCredentialLink. Attendance uses AttendanceCredentialLink.
/// AMF membership is not a foreign key on any certification record (OD-PP-02).
/// Identity images and nationalIdNumber must not be collected before DPIA (OD-PP-05).
/// IdentityCheck.method allows human visual review only (OD-PP-04). No biometric template column.

enum CourseLifecycle {
  DRAFT
  IN_TC_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
}

enum ContentBlockKind {
  PDF
  VIDEO
  TEXT
}

enum CourseApprovalCapacity {
  TECHNICAL_COMMITTEE
  DIRECTOR
}

enum ItemReviewState {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum ItemReviewOutcome {
  APPROVED
  REJECTED
}

enum LearningObjectKind {
  COURSE
  LESSON
  QUIZ
  EXAM
  ITEM
}

/// Payment is not collected in this slice. PENDING_PAYMENT is a stub state.
enum EnrolmentPaymentState {
  PENDING_PAYMENT
  NOT_REQUIRED
}

enum ExamFormLifecycle {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum IdentityVerificationState {
  UNVERIFIED
  VERIFIED
  REJECTED
  ADDITIONAL_EVIDENCE_REQUESTED
}

enum IdentityCheckMethod {
  HUMAN_VISUAL
}

/// Document kind only. The document number and any image stay uncollected until a DPIA.
enum IdentityDocumentType {
  PASSPORT
  ID_CARD
  DRIVING_LICENCE
  RESIDENCE_PERMIT
}

enum ExamDutyKind {
  EXAMINER
  INVIGILATOR
}

enum ExamAttemptLifecycle {
  IN_PROGRESS
  SUBMITTED
  INTERRUPTED
  VOID
}

enum ProctorSignalSource {
  HUMAN
  AI
}

enum ProctorSignalDisposition {
  DISMISSED
  CONFIRMED_BY_INVIGILATOR
}

enum CertificationPathway {
  CONFORA_TRAINING
  EXTERNAL_EQUIVALENT
}

enum SchemeVersionLifecycle {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

enum CredentialType {
  ATTENDANCE
  PERSONNEL
}

enum CredentialLifecycle {
  ACTIVE
  EXPIRED
  SUSPENDED
  WITHDRAWN
  SCOPE_REDUCED
}

enum VerificationResult {
  ACTIVE
  EXPIRED
  SUSPENDED
  WITHDRAWN
  SCOPE_REDUCED
  NOT_FOUND
}

enum RecertificationLifecycle {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentLifecycle {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MembershipLifecycle {
  DUE
  PAID
  PROPOSAL_PENDING
  SUSPENDED
  WITHDRAWN
}

enum SuspensionProposalLifecycle {
  PROPOSED
  CONFIRMED
  REJECTED
  WITHDRAWN_AFTER_DEADLINE
}

enum DocumentLifecycle {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum RiskBand {
  GREEN
  YELLOW
  RED
}

enum InternalAuditLifecycle {
  PLANNED
  IN_PROGRESS
  REPORTED
  CLOSED
}

enum CorrectiveActionLifecycle {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum AiSuggestionLifecycle {
  PENDING
  ACCEPTED
  REJECTED
}

enum AiReviewOutcome {
  ACCEPTED
  REJECTED
}

enum StaffDeclarationKind {
  CONFIDENTIALITY
  IMPARTIALITY
}

model UserProfile {
  id                        String                    @id @default(uuid()) @db.Uuid
  tenantId                  String                    @db.Uuid
  userId                    String                    @db.Uuid
  givenName                 String                    @db.VarChar(128)
  familyName                String                    @db.VarChar(128)
  nationalIdNumber          String?                   @db.VarChar(32)
  phone                     String?                   @db.VarChar(32)
  jobTitle                  String?                   @db.VarChar(128)
  organizationName          String?                   @db.VarChar(256)
  educationLevel            String?                   @db.VarChar(128)
  identityVerificationState IdentityVerificationState @default(UNVERIFIED)
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                  @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, nationalIdNumber])
  @@index([tenantId])
}

model UserAccessibilityNeed {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  needCode         String   @db.VarChar(64)
  extraTimePercent Int?
  note             String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, needCode])
  @@index([tenantId])
}

model CommitteeMembership {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  userId            String    @db.Uuid
  canonicalCode     String    @db.VarChar(64)
  committeeCode     String    @db.VarChar(64)
  activeFrom        DateTime  @db.Timestamptz(3)
  activeUntil       DateTime? @db.Timestamptz(3)
  appointedByUserId String    @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  member    User   @relation("CommitteeMember", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  appointer User   @relation("CommitteeAppointer", fields: [tenantId, appointedByUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, canonicalCode])
  @@index([tenantId, userId])
}

model BreakGlassAccess {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  actorUserId String    @db.Uuid
  reason      String    @db.Text
  scopeLabel  String    @db.VarChar(128)
  ticketRef   String    @db.VarChar(128)
  startedAt   DateTime  @db.Timestamptz(3)
  endedAt     DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, actorUserId, startedAt])
}

model StaffDeclaration {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  userId             String               @db.Uuid
  kind               StaffDeclarationKind
  signedAt           DateTime             @db.Timestamptz(3)
  documentVersionRef String?              @db.VarChar(64)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, userId, kind])
}

model Competence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String   @db.VarChar(64)
  statement String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  levels              ProficiencyLevel[]
  itemLinks           AssessmentItemCompetence[]
  schemeLinks         SchemeCompetenceRequirement[]
  schemeExamItemLinks SchemeExamItemCompetence[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model ProficiencyLevel {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  competenceId String   @db.Uuid
  levelCode    String   @db.VarChar(32)
  descriptor   String   @db.Text
  rank         Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  competence  Competence                    @relation(fields: [tenantId, competenceId], references: [tenantId, id], onDelete: Restrict)
  itemLinks   AssessmentItemCompetence[]
  schemeLinks SchemeCompetenceRequirement[]

  @@unique([tenantId, id])
  @@unique([tenantId, competenceId, levelCode])
  @@index([tenantId])
}

model Course {
  id                         String          @id @default(uuid()) @db.Uuid
  tenantId                   String          @db.Uuid
  code                       String          @db.VarChar(64)
  title                      String          @db.VarChar(256)
  description                String          @db.Text
  areaCode                   String          @db.VarChar(64)
  imageObjectKey             String?         @db.VarChar(512)
  language                   String          @db.VarChar(16)
  educationalLevel           String?         @db.VarChar(64)
  targetAudience             String?         @db.Text
  typicalLearningTimeMinutes Int?
  learningObjectives         String?         @db.Text
  standardReference          String?         @db.VarChar(128)
  priceAmount                Decimal         @db.Decimal(12, 2)
  priceCurrency              String          @db.Char(3)
  requiresCertification      Boolean         @default(false)
  minimumTimeSeconds         Int             @default(0)
  lifecycle                  CourseLifecycle @default(DRAFT)
  authorUserId               String          @db.Uuid
  createdAt                  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime        @updatedAt @db.Timestamptz(3)

  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  author          User                       @relation("CourseAuthor", fields: [tenantId, authorUserId], references: [tenantId, id], onDelete: Restrict)
  chapters        CourseChapter[]
  approvals       CourseApproval[]
  enrolments      Enrolment[]
  scenarioGroups  ItemScenarioGroup[]
  items           AssessmentItem[]
  examFormCourses ExamFormCourse[]
  attendanceLinks AttendanceCredentialLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, areaCode, lifecycle])
}

model CourseChapter {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  courseId           String   @db.Uuid
  sequence           Int
  title              String   @db.VarChar(256)
  minimumTimeSeconds Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course  Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  lessons CourseLesson[]
  quizzes Quiz[]

  @@unique([tenantId, id])
  @@unique([tenantId, courseId, sequence])
  @@index([tenantId, courseId])
}

model CourseLesson {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  chapterId          String   @db.Uuid
  sequence           Int
  title              String   @db.VarChar(256)
  minimumTimeSeconds Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
