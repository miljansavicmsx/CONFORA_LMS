generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String          @id @default(uuid()) @db.Uuid
  isActive      Boolean         @default(false)
  users         User[]
  auditEvents   AuditEvent[]
  auditChainHead AuditChainHead?
}

model User {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @db.Uuid
  email              String
  isActive           Boolean                @default(false)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  externalIdentities ExternalIdentityLink[]
  auditEvents        AuditEvent[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
}

model ExternalIdentityLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid
  issuer   String
  subject  String
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, issuer, subject])
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model AuditEvent {
  id             String       @id @db.Uuid
  tenantId       String       @db.Uuid
  sequence       BigInt
  idempotencyKey String       @db.Uuid
  actorUserId    String       @db.Uuid
  eventType      String       @db.VarChar(128)
  outcome        AuditOutcome
  resourceType   String?      @db.VarChar(128)
  resourceId     String?      @db.VarChar(128)
  occurredAt     DateTime     @db.Timestamptz(3)
  recordedAt     DateTime     @db.Timestamptz(3)
  correlationId  String?      @db.VarChar(128)
  metadata       Json?
  prevHash       String       @db.Char(64)
  payloadHash    String       @db.Char(64)
  chainHash      String       @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, sequence])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, recordedAt])
}

model AuditChainHead {
  tenantId     String @id @db.Uuid
  lastSequence BigInt
  lastHash     String @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}
