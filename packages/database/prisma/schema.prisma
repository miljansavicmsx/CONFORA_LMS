enum RecertificationReminderKind {
  NINETY_DAYS
  THIRTY_DAYS
  ON_EXPIRY
}

/// Personnel certificate issued after an exam GRANT. Distinct from course attendance.
model ExamPersonnelCredentialLink {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  credentialId       String    @db.Uuid
  examDecisionId     String    @db.Uuid
  schemeVersionId    String    @db.Uuid
  holderDisplayName  String    @db.VarChar(256)
  registryListed     Boolean   @default(false)
  registryConsentAt  DateTime? @db.Timestamptz(3)
  statusListIndex    Int
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  credential    Credential                 @relation(fields: [tenantId, credentialId], references: [tenantId, id], onDelete: Restrict)
  examDecision  ExamCertificationDecision  @relation(fields: [tenantId, examDecisionId], references: [tenantId, id], onDelete: Restrict)
  schemeVersion CertificationSchemeVersion @relation(fields: [tenantId, schemeVersionId], references: [tenantId, id], onDelete: Restrict)
  reminders     RecertificationReminder[]
  cpdRecords    CpdRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, credentialId])
  @@unique([tenantId, examDecisionId])
  @@unique([statusListIndex])
  @@index([tenantId, registryListed])
}

model RecertificationReminder {
