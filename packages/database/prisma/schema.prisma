/// Certification item bank. Separate from course quiz items.
/// Stems are confidential: learner and AI surfaces must not receive them outside an active session.
enum SchemeExamItemType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum SchemeExamItemStatus {
  DRAFT
  REVIEW
  APPROVED
  RETIRED
}

enum ExamBlueprintStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum StandardSettingMethod {
  ANGOFF
}

enum StandardSettingStatus {
  DRAFT
  APPROVED
}

enum CertificationExamSessionStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  SUBMITTED
  SCORED
  VOID
}

/// Webcam and identity-document images stay uncollected until a DPIA (OD-PP-05).
enum IdentityCaptureState {
  NOT_COLLECTED_DPIA_PENDING
}

enum ExamCertificationDecisionOutcome {
  GRANT
  DENY
}

enum ExamProctorDisposition {
  DISMISSED
  CONFIRMED_FOR_REVIEW
}

model SchemeExamItem {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  schemeId      String               @db.Uuid
  familyKey     String               @db.VarChar(64)
  version       Int
  stem          String               @db.Text
  itemType      SchemeExamItemType
  status        SchemeExamItemStatus @default(DRAFT)
  authorUserId  String               @db.Uuid
  domainCode    String               @db.VarChar(64)
  exposureCount Int                  @default(0)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  tenant       Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scheme       CertificationScheme        @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Restrict)
  author       User                       @relation("SchemeExamItemAuthor", fields: [tenantId, authorUserId], references: [tenantId, id], onDelete: Restrict)
  choices      SchemeExamItemChoice[]
  competences  SchemeExamItemCompetence[]
  transitions  SchemeExamItemTransition[]
  ratings      StandardSettingRating[]
  formItems    AssembledExamFormItem[]
  answers      CertificationExamAnswer[]
  statistics   ExamItemStatistic[]

  @@unique([tenantId, id])
  @@unique([tenantId, familyKey, version])
  @@index([tenantId, schemeId, status, domainCode])
  @@index([tenantId, authorUserId])
}

model SchemeExamItemChoice {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  itemId    String   @db.Uuid
  choiceKey String   @db.VarChar(16)
  text      String   @db.Text
  isCorrect Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item   SchemeExamItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, itemId, choiceKey])
  @@index([tenantId])
}

model SchemeExamItemCompetence {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  itemId       String   @db.Uuid
  competenceId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item       SchemeExamItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  competence Competence     @relation(fields: [tenantId, competenceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, itemId, competenceId])
  @@index([tenantId, competenceId])
}

model SchemeExamItemTransition {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  itemId      String               @db.Uuid
  actorUserId String               @db.Uuid
  fromStatus  SchemeExamItemStatus
  toStatus    SchemeExamItemStatus
  note        String?              @db.Text
  actedAt     DateTime             @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item   SchemeExamItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  actor  User           @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, itemId, actedAt])
}

model ExamBlueprint {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  schemeVersionId  String              @db.Uuid
  title            String              @db.VarChar(256)
  durationSeconds  Int
  status           ExamBlueprintStatus @default(DRAFT)
  retakeWindowDays Int                 @default(90)
  cutScoreBasisPoints Int?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
