  panelist User                  @relation("StandardSettingPanelist", fields: [tenantId, panelistUserId], references: [tenantId, id], onDelete: Restrict)
  item     SchemeExamItem        @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, recordId, panelistUserId, itemId])
  @@index([tenantId, itemId])
}

model AssembledExamForm {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  blueprintId     String   @db.Uuid
  title           String   @db.VarChar(256)
  shuffleItems    Boolean  @default(true)
  shuffleChoices  Boolean  @default(true)
  assembledByUserId String @db.Uuid
  assembledAt     DateTime @db.Timestamptz(3)
