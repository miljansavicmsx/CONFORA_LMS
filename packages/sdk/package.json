{
  "name": "@confora/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript http://127.0.0.1:4000/openapi/json -o src/generated/schema.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"console.log('sdk: no tests');\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@confora/config": "workspace:*",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3"
  }
}
