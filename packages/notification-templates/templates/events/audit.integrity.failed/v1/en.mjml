<mjml>
  <mj-head>
    <mj-title>Audit integrity</mj-title>
  </mj-head>
  <mj-body background-color="#fef2f2">
    <mj-section background-color="#ffffff" padding="24px" border="2px solid #dc2626">
      <mj-column>
        <mj-text color="#b91c1c" font-weight="700" font-size="18px">Audit integrity failure</mj-text>
        <mj-text padding-top="12px">{{heading}}</mj-text>
        <mj-text padding-top="12px" font-size="14px">{{bodyText}}</mj-text>
        <mj-text padding-top="16px" font-size="13px" color="#64748b">{{footer}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
