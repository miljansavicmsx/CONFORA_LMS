{
  "name": "@confora/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build --builder tsc",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "test:coverage:enforce": "cross-env COVERAGE_ENFORCE=1 jest --runInBand --coverage",
    "test:compliance": "jest --config ./jest.compliance.config.cjs --runInBand",
    "test:integration": "jest --config ./jest.integration.config.cjs --runInBand",
    "test:e2e": "jest --config ./jest-e2e.config.cjs --runInBand",
    "test:verify-load": "node test/verify-load.mjs"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@confora/ai-client": "workspace:*",
    "@confora/ai-prompts": "workspace:*",
    "@confora/audit-client": "workspace:*",
    "@confora/notification-templates": "workspace:*",
    "@confora/shared-kernel": "workspace:*",
    "@confora/shared-types": "workspace:*",
    "@nestjs/apollo": "^12.2.1",
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/graphql": "^12.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^6.19.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "amqplib": "^0.10.4",
    "exceljs": "^4.4.0",
    "graphql": "^16.9.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "mjml": "^4.15.3",
    "multer": "^2.1.1",
    "nestjs-zod": "^4.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@confora/config": "workspace:*",
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.8",
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
