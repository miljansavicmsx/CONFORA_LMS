  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@confora/config": "workspace:*",
    "eslint": "^9.15.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.2.1"
