{
  "name": "confora",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.14.2"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api:pilot": "node scripts/ops/start-api-with-pilot-env.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docker:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "prepare": "husky",
    "a11y:lighthouse": "node scripts/a11y/run-lighthouse.mjs",
    "a11y:aggregate": "node scripts/a11y/aggregate-report.mjs",
    "a11y:compare-baseline": "node scripts/a11y/compare-baseline.mjs",
    "a11y:contrast": "tsx tools/a11y/contrast-check.ts",
    "ops:soak-summary": "node scripts/ops/generate-soak-summary.mjs",
    "ops:soak-probes-test": "node --test scripts/ops/soak-daily-probes.test.mjs",
    "ops:soak-reset": "node scripts/ops/reset-soak-window.mjs",
    "ops:b3-3d-smoke": "node scripts/ops/run-b3-3d-draft-write-smoke.mjs",
