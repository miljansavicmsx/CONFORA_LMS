    "ops:public-ux-1r3": "node scripts/ops/run-public-ux-1r3.mjs",
    "ops:cert-ops-1r": "node scripts/ops/run-cert-ops-1r.mjs",
    "ops:support-contact-1r": "node scripts/ops/run-support-contact-1r.mjs",
    "ops:f5-6-operational-runbooks": "node scripts/ops/run-f5-6-operational-runbooks.mjs",
    "ops:f5-7-final-go-no-go": "node scripts/ops/run-f5-7-final-go-no-go.mjs",
    "ops:ca-h01-frontend-f4-cutover": "node scripts/ops/run-ca-h01-frontend-f4-cutover.mjs",
    "ops:f5-7-recheck-after-ca-h01": "node scripts/ops/run-f5-7-recheck-after-ca-h01.mjs",
    "ops:s17-public-verify-browser": "node scripts/ops/run-s17-public-verify-browser.mjs",
    "ops:staff-mfa-2-pre-external-cutover": "node scripts/ops/run-staff-mfa-2-pre-external-cutover.mjs",
    "ops:staff-mfa-3-enforcement-closure": "node scripts/ops/run-staff-mfa-3-enforcement-closure.mjs",
    "ops:dpo-legal-1-external-pilot-review-package": "node scripts/ops/run-dpo-legal-1-external-pilot-review-package.mjs",
